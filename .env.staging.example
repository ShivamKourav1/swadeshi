# =========================================================================
# Application Configuration (Staging - dev.panchp.in)
# =========================================================================
APP_NAME="वस्तु भंडार (Staging)"
APP_ENV=staging
APP_KEY=
APP_DEBUG=true
APP_URL=https://dev.panchp.in

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# =========================================================================
# Logging Configuration
# =========================================================================
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =========================================================================
# Database Configuration (Matches docker-compose.staging.yml postgres service)
# =========================================================================
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ecommerce_staging_db
DB_USERNAME=ecommerce_staging_user
DB_PASSWORD=CHANGE_ME_TO_A_SECURE_STAGING_DB_PASSWORD

# =========================================================================
# Session, Cache & Queue (Redis backed, distinct staging prefix)
# =========================================================================
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
CACHE_PREFIX=vastu_staging_cache_

QUEUE_CONNECTION=redis

# =========================================================================
# Redis Configuration (Matches docker-compose.staging.yml redis service)
# =========================================================================
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME_TO_A_SECURE_STAGING_REDIS_PASSWORD
REDIS_PORT=6379

# =========================================================================
# Filesystem Storage
# =========================================================================
FILESYSTEM_DISK=public

# =========================================================================
# Port Configuration (For Docker port binding on the server)
# 8081 proxies to 80, 8444 proxies to 443
# =========================================================================
HTTP_PORT=8081
HTTPS_PORT=8444

# =========================================================================
# Mail Configuration (Optional mock / log mailer for staging)
# =========================================================================
MAIL_MAILER=log
MAIL_FROM_ADDRESS="dev-no-reply@panchp.in"
MAIL_FROM_NAME="${APP_NAME}"

# =========================================================================
# Vite & Frontend Environment
# =========================================================================
VITE_APP_NAME="${APP_NAME}"
