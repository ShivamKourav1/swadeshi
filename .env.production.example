# =========================================================================
# Application Configuration
# =========================================================================
APP_NAME="वस्तु भंडार"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# =========================================================================
# Logging Configuration
# =========================================================================
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# =========================================================================
# Database Configuration (Matches docker-compose.prod.yml postgres service)
# =========================================================================
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ecommerce_db
DB_USERNAME=ecommerce_user
DB_PASSWORD=CHANGE_ME_TO_A_SECURE_POSTGRES_PASSWORD

# =========================================================================
# Session, Cache & Queue (Redis backed)
# =========================================================================
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
CACHE_PREFIX=vastu_cache_

QUEUE_CONNECTION=redis

# =========================================================================
# Redis Configuration (Matches docker-compose.prod.yml redis service)
# =========================================================================
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME_TO_A_SECURE_REDIS_PASSWORD
REDIS_PORT=6379

# =========================================================================
# Filesystem Storage
# =========================================================================
FILESYSTEM_DISK=public

# AWS S3 Storage (Optional: if storing uploads in AWS S3 or Cloudflare R2)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# =========================================================================
# Mail Configuration (SMTP / Postmark / Sendgrid / SES)
# =========================================================================
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# =========================================================================
# Vite & Frontend Environment
# =========================================================================
VITE_APP_NAME="${APP_NAME}"
